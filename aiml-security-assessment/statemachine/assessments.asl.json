{
    "Comment": "A state machine that performs AI/ML security assessments across multiple regions.",
    "StartAt": "Configure Service Assessments",
    "States": {
        "Configure Service Assessments": {
            "Type": "Pass",
            "Result": {
                "bedrock": "${EnableBedrockAssessment}",
                "sagemaker": "${EnableSageMakerAssessment}",
                "agentcore": "${EnableAgentCoreAssessment}",
                "agent-registry": "${EnableAgentRegistryAssessment}"
            },
            "ResultPath": "$.ServiceSelection",
            "Next": "Cleanup S3 Bucket"
        },
        "Cleanup S3 Bucket": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${CleanupBucketFunction}",
                "Payload": {
                    "Execution.$": "$$.Execution",
                    "StateMachine.$": "$$.StateMachine"
                }
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 1,
                    "MaxAttempts": 3,
                    "BackoffRate": 2,
                    "JitterStrategy": "FULL"
                }
            ],
            "ResultPath": null,
            "Next": "IAM Permission Caching"
        },
        "IAM Permission Caching": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${IAMPermissionCachingFunction}",
                "Payload": {
                    "Execution.$": "$$.Execution",
                    "StateMachine.$": "$$.StateMachine"
                }
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 1,
                    "MaxAttempts": 3,
                    "BackoffRate": 2,
                    "JitterStrategy": "FULL"
                }
            ],
            "ResultPath": null,
            "Next": "Resolve Target Regions"
        },
        "Resolve Target Regions": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${ResolveRegionsFunction}",
                "Payload": {
                    "Execution.$": "$$.Execution",
                    "StateMachine.$": "$$.StateMachine"
                }
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 1,
                    "MaxAttempts": 3,
                    "BackoffRate": 2,
                    "JitterStrategy": "FULL"
                }
            ],
            "ResultPath": "$.ResolvedRegions",
            "ResultSelector": {
                "regions.$": "$.Payload.regions"
            },
            "Next": "Scan Regions"
        },
        "Scan Regions": {
            "Type": "Map",
            "ItemsPath": "$.ResolvedRegions.regions",
            "ItemSelector": {
                "Region.$": "$$.Map.Item.Value",
                "RegionIndex.$": "$$.Map.Item.Index",
                "Execution.$": "$$.Execution",
                "StateMachine.$": "$$.StateMachine",
                "OriginalInput.$": "$"
            },
            "MaxConcurrency": ${MaxRegionConcurrency},
            "ItemProcessor": {
                "ProcessorConfig": {
                    "Mode": "INLINE"
                },
                "StartAt": "Run Security Assessments",
                "States": {
                    "Run Security Assessments": {
                        "Type": "Parallel",
                        "Branches": [
                            {
                                "StartAt": "Bedrock Assessment Enabled?",
                                "States": {
                                    "Bedrock Assessment Enabled?": {
                                        "Type": "Choice",
                                        "Choices": [
                                            {
                                                "Variable": "$.OriginalInput.ServiceSelection['bedrock']",
                                                "StringEquals": "true",
                                                "Next": "Bedrock Security Assessment"
                                            }
                                        ],
                                        "Default": "Bedrock Assessment Not Selected"
                                    },
                                    "Bedrock Security Assessment": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::lambda:invoke",
                                        "Parameters": {
                                            "FunctionName": "${BedrockSecurityAssessmentFunction}",
                                            "Payload": {
                                                "Execution.$": "$.Execution",
                                                "StateMachine.$": "$.StateMachine",
                                                "Region.$": "$.Region",
                                                "RegionIndex.$": "$.RegionIndex"
                                            }
                                        },
                                        "Retry": [
                                            {
                                                "ErrorEquals": [
                                                    "Lambda.ServiceException",
                                                    "Lambda.AWSLambdaException",
                                                    "Lambda.SdkClientException",
                                                    "Lambda.TooManyRequestsException"
                                                ],
                                                "IntervalSeconds": 1,
                                                "MaxAttempts": 3,
                                                "BackoffRate": 2,
                                                "JitterStrategy": "FULL"
                                            }
                                        ],
                                        "Catch": [
                                            {
                                                "ErrorEquals": [
                                                    "States.ALL"
                                                ],
                                                "ResultPath": "$.assessmentError",
                                                "Next": "Bedrock Assessment Incomplete"
                                            }
                                        ],
                                        "End": true
                                    },
                                    "Bedrock Assessment Incomplete": {
                                        "Type": "Pass",
                                        "Result": {
                                            "statusCode": 207,
                                            "incomplete": true,
                                            "body": {
                                                "findings": []
                                            }
                                        },
                                        "End": true
                                    },
                                    "Bedrock Assessment Not Selected": {
                                        "Type": "Pass",
                                        "Result": {
                                            "statusCode": 200,
                                            "skipped": true,
                                            "reason": "not-selected",
                                            "service": "bedrock"
                                        },
                                        "End": true
                                    }
                                }
                            },
                            {
                                "StartAt": "Sagemaker Assessment Enabled?",
                                "States": {
                                    "Sagemaker Assessment Enabled?": {
                                        "Type": "Choice",
                                        "Choices": [
                                            {
                                                "Variable": "$.OriginalInput.ServiceSelection['sagemaker']",
                                                "StringEquals": "true",
                                                "Next": "Sagemaker Security Assessment"
                                            }
                                        ],
                                        "Default": "Sagemaker Assessment Not Selected"
                                    },
                                    "Sagemaker Security Assessment": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::lambda:invoke",
                                        "Parameters": {
                                            "FunctionName": "${SagemakerSecurityAssessmentFunction}",
                                            "Payload": {
                                                "Execution.$": "$.Execution",
                                                "StateMachine.$": "$.StateMachine",
                                                "Region.$": "$.Region",
                                                "RegionIndex.$": "$.RegionIndex"
                                            }
                                        },
                                        "Retry": [
                                            {
                                                "ErrorEquals": [
                                                    "Lambda.ServiceException",
                                                    "Lambda.AWSLambdaException",
                                                    "Lambda.SdkClientException",
                                                    "Lambda.TooManyRequestsException"
                                                ],
                                                "IntervalSeconds": 1,
                                                "MaxAttempts": 3,
                                                "BackoffRate": 2,
                                                "JitterStrategy": "FULL"
                                            }
                                        ],
                                        "Catch": [
                                            {
                                                "ErrorEquals": [
                                                    "States.ALL"
                                                ],
                                                "ResultPath": "$.assessmentError",
                                                "Next": "Sagemaker Assessment Incomplete"
                                            }
                                        ],
                                        "End": true
                                    },
                                    "Sagemaker Assessment Incomplete": {
                                        "Type": "Pass",
                                        "Result": {
                                            "statusCode": 207,
                                            "incomplete": true,
                                            "body": {
                                                "findings": []
                                            }
                                        },
                                        "End": true
                                    },
                                    "Sagemaker Assessment Not Selected": {
                                        "Type": "Pass",
                                        "Result": {
                                            "statusCode": 200,
                                            "skipped": true,
                                            "reason": "not-selected",
                                            "service": "sagemaker"
                                        },
                                        "End": true
                                    }
                                }
                            },
                            {
                                "StartAt": "AgentCore Assessment Enabled?",
                                "States": {
                                    "AgentCore Assessment Enabled?": {
                                        "Type": "Choice",
                                        "Choices": [
                                            {
                                                "Variable": "$.OriginalInput.ServiceSelection['agentcore']",
                                                "StringEquals": "true",
                                                "Next": "AgentCore Security Assessment"
                                            }
                                        ],
                                        "Default": "AgentCore Assessment Not Selected"
                                    },
                                    "AgentCore Security Assessment": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::lambda:invoke",
                                        "Parameters": {
                                            "FunctionName": "${AgentCoreSecurityAssessmentFunction}",
                                            "Payload": {
                                                "Execution.$": "$.Execution",
                                                "StateMachine.$": "$.StateMachine",
                                                "Region.$": "$.Region",
                                                "RegionIndex.$": "$.RegionIndex"
                                            }
                                        },
                                        "Retry": [
                                            {
                                                "ErrorEquals": [
                                                    "Lambda.ServiceException",
                                                    "Lambda.AWSLambdaException",
                                                    "Lambda.SdkClientException",
                                                    "Lambda.TooManyRequestsException"
                                                ],
                                                "IntervalSeconds": 1,
                                                "MaxAttempts": 3,
                                                "BackoffRate": 2,
                                                "JitterStrategy": "FULL"
                                            }
                                        ],
                                        "Catch": [
                                            {
                                                "ErrorEquals": [
                                                    "States.ALL"
                                                ],
                                                "ResultPath": "$.assessmentError",
                                                "Next": "AgentCore Assessment Incomplete"
                                            }
                                        ],
                                        "End": true
                                    },
                                    "AgentCore Assessment Incomplete": {
                                        "Type": "Pass",
                                        "Result": {
                                            "statusCode": 207,
                                            "incomplete": true,
                                            "body": {
                                                "findings": []
                                            }
                                        },
                                        "End": true
                                    },
                                    "AgentCore Assessment Not Selected": {
                                        "Type": "Pass",
                                        "Result": {
                                            "statusCode": 200,
                                            "skipped": true,
                                            "reason": "not-selected",
                                            "service": "agentcore"
                                        },
                                        "End": true
                                    }
                                }
                            },
                            {
                                "StartAt": "AWS Agent Registry Assessment Enabled?",
                                "States": {
                                    "AWS Agent Registry Assessment Enabled?": {
                                        "Type": "Choice",
                                        "Choices": [
                                            {
                                                "Variable": "$.OriginalInput.ServiceSelection['agent-registry']",
                                                "StringEquals": "true",
                                                "Next": "AWS Agent Registry Security Assessment"
                                            }
                                        ],
                                        "Default": "AWS Agent Registry Assessment Not Selected"
                                    },
                                    "AWS Agent Registry Security Assessment": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::lambda:invoke",
                                        "Parameters": {
                                            "FunctionName": "${AgentRegistrySecurityAssessmentFunction}",
                                            "Payload": {
                                                "Execution.$": "$.Execution",
                                                "StateMachine.$": "$.StateMachine",
                                                "Region.$": "$.Region",
                                                "RegionIndex.$": "$.RegionIndex"
                                            }
                                        },
                                        "Retry": [
                                            {
                                                "ErrorEquals": [
                                                    "Lambda.ServiceException",
                                                    "Lambda.AWSLambdaException",
                                                    "Lambda.SdkClientException",
                                                    "Lambda.TooManyRequestsException"
                                                ],
                                                "IntervalSeconds": 1,
                                                "MaxAttempts": 3,
                                                "BackoffRate": 2,
                                                "JitterStrategy": "FULL"
                                            }
                                        ],
                                        "Catch": [
                                            {
                                                "ErrorEquals": [
                                                    "States.ALL"
                                                ],
                                                "ResultPath": "$.assessmentError",
                                                "Next": "AWS Agent Registry Assessment Incomplete"
                                            }
                                        ],
                                        "End": true
                                    },
                                    "AWS Agent Registry Assessment Incomplete": {
                                        "Type": "Pass",
                                        "Result": {
                                            "statusCode": 207,
                                            "incomplete": true,
                                            "body": {
                                                "findings": []
                                            }
                                        },
                                        "End": true
                                    },
                                    "AWS Agent Registry Assessment Not Selected": {
                                        "Type": "Pass",
                                        "Result": {
                                            "statusCode": 200,
                                            "skipped": true,
                                            "reason": "not-selected",
                                            "service": "agent-registry"
                                        },
                                        "End": true
                                    }
                                }
                            },
                            {
                                "StartAt": "Responsible AI GRC Enabled?",
                                "States": {
                                    "Responsible AI GRC Enabled?": {
                                        "Type": "Choice",
                                        "Choices": [
                                            {
                                                "And": [
                                                    {
                                                        "Variable": "$.OriginalInput.enableFinServ",
                                                        "IsPresent": true
                                                    },
                                                    {
                                                        "Variable": "$.OriginalInput.enableFinServ",
                                                        "StringEquals": "true"
                                                    },
                                                    {
                                                        "Variable": "$.RegionIndex",
                                                        "NumericEquals": 0
                                                    }
                                                ],
                                                "Next": "Legacy enableFinServ Input Rejected"
                                            },
                                            {
                                                "And": [
                                                    {
                                                        "Variable": "$.OriginalInput.enableResponsibleAIGRC",
                                                        "IsPresent": true
                                                    },
                                                    {
                                                        "Variable": "$.OriginalInput.enableResponsibleAIGRC",
                                                        "StringEquals": "true"
                                                    },
                                                    {
                                                        "Variable": "$.RegionIndex",
                                                        "NumericEquals": 0
                                                    }
                                                ],
                                                "Next": "Responsible AI GRC Security Assessment"
                                            },
                                            {
                                                "And": [
                                                    {
                                                        "Variable": "$.OriginalInput.enableOWASP",
                                                        "IsPresent": true
                                                    },
                                                    {
                                                        "Variable": "$.OriginalInput.enableOWASP",
                                                        "StringEquals": "true"
                                                    },
                                                    {
                                                        "Variable": "$.RegionIndex",
                                                        "NumericEquals": 0
                                                    }
                                                ],
                                                "Next": "Responsible AI GRC Security Assessment"
                                            }
                                        ],
                                        "Default": "Responsible AI GRC Assessment Skipped"
                                    },
                                    "Legacy enableFinServ Input Rejected": {
                                        "Type": "Fail",
                                        "Error": "LegacyEnableFinServInputRejected",
                                        "Cause": "The Step Functions execution input included \"enableFinServ\": \"true\", which this state machine no longer reads. Use \"enableResponsibleAIGRC\": \"true\" (or \"enableOWASP\": \"true\") in the execution input instead. The EnableFinServAssessment CloudFormation parameter and ENABLE_FINSERV CodeBuild environment variable are still supported as a legacy alias for CodeBuild-driven deployments -- buildspec.yml resolves that alias into enableResponsibleAIGRC before starting this execution. This failure only occurs when enableFinServ is passed directly to StartExecution, bypassing that resolution."
                                    },
                                    "Responsible AI GRC Security Assessment": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::lambda:invoke",
                                        "Parameters": {
                                            "FunctionName": "${ResponsibleAIGRCAssessmentFunction}",
                                            "Payload": {
                                                "Execution.$": "$.Execution",
                                                "StateMachine.$": "$.StateMachine",
                                                "Region.$": "$.Region",
                                                "RegionIndex.$": "$.RegionIndex",
                                                "TargetRegions.$": "$.OriginalInput.ResolvedRegions.regions"
                                            }
                                        },
                                        "Retry": [
                                            {
                                                "ErrorEquals": [
                                                    "Lambda.ServiceException",
                                                    "Lambda.AWSLambdaException",
                                                    "Lambda.SdkClientException",
                                                    "Lambda.TooManyRequestsException"
                                                ],
                                                "IntervalSeconds": 1,
                                                "MaxAttempts": 3,
                                                "BackoffRate": 2,
                                                "JitterStrategy": "FULL"
                                            }
                                        ],
                                        "Catch": [
                                            {
                                                "ErrorEquals": [
                                                    "States.ALL"
                                                ],
                                                "ResultPath": "$.responsibleAIGRCError",
                                                "Next": "Responsible AI GRC Assessment Incomplete"
                                            }
                                        ],
                                        "End": true
                                    },
                                    "Responsible AI GRC Assessment Incomplete": {
                                        "Type": "Pass",
                                        "Result": {
                                            "statusCode": 207,
                                            "incomplete": true,
                                            "body": {
                                                "findings": []
                                            }
                                        },
                                        "End": true
                                    },
                                    "Responsible AI GRC Assessment Skipped": {
                                        "Type": "Pass",
                                        "Result": {
                                            "statusCode": 200,
                                            "skipped": true,
                                            "body": {
                                                "findings": []
                                            }
                                        },
                                        "End": true
                                    }
                                }
                            }
                        ],
                        "ResultPath": null,
                        "Next": "OWASP Enabled?"
                    },
                    "OWASP Enabled?": {
                        "Type": "Choice",
                        "Choices": [
                            {
                                "And": [
                                    {
                                        "Variable": "$.OriginalInput.enableOWASP",
                                        "IsPresent": true
                                    },
                                    {
                                        "Variable": "$.OriginalInput.enableOWASP",
                                        "StringEquals": "true"
                                    }
                                ],
                                "Next": "OWASP Security Assessment"
                            }
                        ],
                        "Default": "OWASP Assessment Skipped"
                    },
                    "OWASP Security Assessment": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::lambda:invoke",
                        "Parameters": {
                            "FunctionName": "${OWASPSecurityAssessmentFunction}",
                            "Payload": {
                                "Execution.$": "$.Execution",
                                "StateMachine.$": "$.StateMachine",
                                "Region.$": "$.Region",
                                "RegionIndex.$": "$.RegionIndex",
                                "ServiceSelection.$": "$.OriginalInput.ServiceSelection"
                            }
                        },
                        "Retry": [
                            {
                                "ErrorEquals": [
                                    "Lambda.ServiceException",
                                    "Lambda.AWSLambdaException",
                                    "Lambda.SdkClientException",
                                    "Lambda.TooManyRequestsException"
                                ],
                                "IntervalSeconds": 1,
                                "MaxAttempts": 3,
                                "BackoffRate": 2,
                                "JitterStrategy": "FULL"
                            }
                        ],
                        "Catch": [
                            {
                                "ErrorEquals": [
                                    "States.ALL"
                                ],
                                "ResultPath": "$.owaspError",
                                "Next": "OWASP Assessment Incomplete"
                            }
                        ],
                        "End": true
                    },
                    "OWASP Assessment Incomplete": {
                        "Type": "Pass",
                        "Result": {
                            "statusCode": 207,
                            "incomplete": true,
                            "body": {
                                "findings": []
                            }
                        },
                        "End": true
                    },
                    "OWASP Assessment Skipped": {
                        "Type": "Pass",
                        "Result": {
                            "statusCode": 200,
                            "skipped": true,
                            "body": {
                                "findings": []
                            }
                        },
                        "End": true
                    }
                }
            },
            "ResultPath": null,
            "Next": "Generate Consolidated Report"
        },
        "Generate Consolidated Report": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${GenerateConsolidatedReportFunction}",
                "Payload": {
                    "Execution.$": "$$.Execution",
                    "OriginalInput.$": "$"
                }
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 1,
                    "MaxAttempts": 3,
                    "BackoffRate": 2,
                    "JitterStrategy": "FULL"
                }
            ],
            "End": true
        }
    }
}
